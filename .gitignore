.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/*.log
logs/*.err

# Experiments output — symlinked to AutoDL data disk, never committed
experiments/

# Results — small artifacts copied by save_artifacts.sh, tracked by git
# Exclude large file types that should never end up in git
results/**/*.jsonl
results/**/*.safetensors
results/**/*.bin
results/**/*.pt
results/**/*.pth
results/**/*.ckpt
results/**/*.gguf
results/*/checkpoints/

# Model checkpoints / artifacts (global)
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.gguf

# HuggingFace cache
.cache/

# OS
.DS_Store
Thumbs.db

# SwanLab local
swanlog/

# Large data
data/models/
data/sft_dataset/*.jsonl
!data/task_splits/*.json
